<view class="hero card">
  <view class="hero-title">ScolvPet 熊舍</view>
  <view class="muted" style="margin-top:8rpx;">浏览公开宝宝 · 查看血统 · 繁育模拟 · 短信验证后预订</view>
  <view class="muted" style="margin-top:12rpx;">{{hint}}</view>
</view>

<view class="card" wx:if="{{!autoEntering}}">
  <view style="font-weight:700;">进入熊舍</view>
  <input class="field" placeholder="公开路径 slug，例如 my-cattery" value="{{slug}}" bindinput="onSlug" />
  <input class="field" placeholder="手机号（预订时必填）" value="{{phone}}" bindinput="onPhone" />
  <input class="field" placeholder="微信号（选填）" value="{{wechat}}" bindinput="onWechat" />
  <view style="margin-top:28rpx;" class="btn-primary" bindtap="enterCatalog">进入熊舍</view>
  <view style="margin-top:20rpx;text-align:center;" class="link" bindtap="goMy">我的预订</view>
</view>

<view class="card muted" wx:else>正在进入熊舍…</view>
