<view class="card">
  <view style="font-weight:700;">合同 / 回执</view>
  <view class="muted" style="margin-top:8rpx;">粘贴宠舍发来的 public token，或从「我的预订」直接进入。</view>
  <input class="field" placeholder="public token 或 /d/{token} 链接" value="{{token}}" bindinput="onToken" />
  <view class="btn-primary" style="margin-top:24rpx;" bindtap="open">打开</view>
</view>

<view wx:if="{{loading}}" class="card muted">加载中…</view>
<view wx:if="{{error}}" class="card">{{error}}</view>

<view wx:if="{{doc}}" class="card">
  <view style="font-weight:700;">{{doc.title || '单据'}}</view>
  <view class="muted" style="margin-top:8rpx;">状态：{{doc.status || '—'}}</view>
  <view class="muted" wx:if="{{doc.kind}}">类型：{{doc.kind}}</view>
  <view style="margin-top:16rpx;white-space:pre-wrap;">{{doc.body_filled || doc.body || doc.summary || '（无正文预览）'}}</view>
</view>

<view wx:if="{{webUrl}}" class="card">
  <view class="muted">Web 页面（可复制到浏览器查看完整版）：</view>
  <view style="margin-top:8rpx;word-break:break-all;">{{webUrl}}</view>
  <view class="btn-primary" style="margin-top:16rpx;" bindtap="copyWeb">复制链接</view>
</view>
