{
  "name": "scolvpet-miniprogram-next",
  "version": "0.1.0",
  "private": true,
  "description": "ScolvPet B 端小程序(Taro 4 + React + TS,docs/32 迁移工程)",
  "scripts": {
    "build:weapp": "taro build --type weapp",
    "dev:weapp": "taro build --type weapp --watch",
    "lint": "eslint --ext .js,.mjs,.ts,.tsx .",
    "test": "vitest run",
    "test:native": "node --test test/*.test.mjs"
  },
  "browserslist": [
    "last 3 versions",
    "Android >= 4.1",
    "ios >= 8"
  ],
  "dependencies": {
    "@babel/runtime": "7.26.10",
    "@tarojs/components": "4.2.1",
    "@tarojs/helper": "4.2.1",
    "@tarojs/plugin-framework-react": "4.2.1",
    "@tarojs/plugin-platform-weapp": "4.2.1",
    "@tarojs/react": "4.2.1",
    "@tarojs/runtime": "4.2.1",
    "@tarojs/shared": "4.2.1",
    "@tarojs/taro": "4.2.1",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@babel/core": "7.26.10",
    "@babel/preset-react": "7.26.3",
    "@babel/preset-typescript": "7.26.0",
    "@typescript-eslint/eslint-plugin": "7.18.0",
    "@typescript-eslint/parser": "7.18.0",
    "@tarojs/cli": "4.2.1",
    "@tarojs/webpack5-runner": "4.2.1",
    "@testing-library/react": "14.3.1",
    "@types/node": "22.13.10",
    "@types/react": "18.3.18",
    "babel-preset-taro": "4.2.1",
    "jsdom": "24.1.3",
    "eslint": "8.57.1",
    "typescript": "5.6.3",
    "vitest": "2.1.9",
    "webpack": "5.91.0"
  }
}
