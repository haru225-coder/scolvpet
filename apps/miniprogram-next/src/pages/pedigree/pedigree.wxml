<view wx:if="{{loading}}" class="card muted">加载血统…</view>
<view wx:elif="{{error}}" class="card">
  <view>{{error}}</view>
  <view class="btn-primary" style="margin-top:20rpx;" bindtap="reload">重试</view>
</view>
<block wx:else>
  <view class="card">
    <view style="font-weight:800;font-size:34rpx;">🧬 {{title}}</view>
    <view class="muted" style="margin-top:8rpx;">{{note}}</view>
  </view>
  <view class="card gen" wx:for="{{rows}}" wx:key="label">
    <view class="gen-label">{{item.label}}</view>
    <view class="gen-row">
      <view class="node {{n.public ? '' : 'dim'}}" wx:for="{{item.nodes}}" wx:for-item="n" wx:key="role">
        <view class="role">{{n.role}}</view>
        <view class="name">{{n.name}}</view>
        <view class="muted" wx:if="{{n.sex}}">{{n.sex === 'male' ? '♂' : (n.sex === 'female' ? '♀' : '')}}</view>
      </view>
    </view>
  </view>
</block>
