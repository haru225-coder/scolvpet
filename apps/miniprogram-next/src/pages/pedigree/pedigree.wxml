<view wx:if="{{loading}}" class="card muted">加载血统…</view>
<view wx:elif="{{error}}" class="card">
  <view>{{error}}</view>
  <view class="btn-primary" style="margin-top:20rpx;" bindtap="reload">重试</view>
</view>
<block wx:else>
  <view class="card">
    <view style="font-weight:800;font-size:34rpx;">这只从哪来 · {{title}}</view>
    <view class="muted" style="margin-top:8rpx;">{{note}}</view>
  </view>
  <view class="card gen" wx:for="{{rows}}" wx:key="label">
    <view class="gen-label">{{item.label}}</view>
    <view class="gen-row">
      <view
        class="node {{n.public ? '' : 'dim'}} {{n.tappable && n.id !== hamsterId ? 'tappable' : ''}}"
        wx:for="{{item.nodes}}"
        wx:for-item="n"
        wx:key="role"
        data-id="{{n.id}}"
        data-tappable="{{n.tappable}}"
        bindtap="onNode"
      >
        <view class="role">{{n.role}}</view>
        <view class="name">{{n.name}}</view>
        <view class="node-foot">
          <view class="muted" wx:if="{{n.sex}}">{{n.sex === 'male' ? '♂' : (n.sex === 'female' ? '♀' : '')}}</view>
          <view class="peek" wx:if="{{n.tappable && n.id !== hamsterId}}">查看 ›</view>
        </view>
      </view>
    </view>
  </view>
  <view class="card muted" style="font-size:24rpx;">点「查看 ›」可往上看；灰色「没登记」的不能点。</view>
</block>
