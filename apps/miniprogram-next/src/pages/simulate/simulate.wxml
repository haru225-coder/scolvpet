<view class="card">
  <view style="font-weight:800;font-size:34rpx;">这两只会生出什么</view>
  <view class="muted" style="margin-top:8rpx;">先看结论和毛色比例；专业代码在下面。</view>
</view>

<view class="card">
  <view class="label">个体 A</view>
  <picker mode="selector" range="{{hamsters}}" range-key="public_name" bindchange="onSelfChange">
    <view class="field">{{selfName || '选择仓鼠'}}</view>
  </picker>
  <view class="label" style="margin-top:16rpx;">个体 B</view>
  <picker mode="selector" range="{{hamsters}}" range-key="public_name" bindchange="onMateChange">
    <view class="field">{{mateName || '选择配对'}}</view>
  </picker>
  <view class="btn-primary" style="margin-top:24rpx;" bindtap="run">试配一下</view>
</view>

<view wx:if="{{loading}}" class="card muted">计算中…</view>
<view wx:elif="{{error}}" class="card">
  <view>{{error}}</view>
  <view class="btn-primary" style="margin-top:20rpx;" bindtap="run">重试</view>
</view>

<block wx:if="{{result}}">
  <view class="card">
    <view style="font-weight:800;font-size:32rpx;line-height:1.4;">{{result.conclusionLine}}</view>
    <view class="muted" style="margin-top:12rpx;">
      {{result.sire_name || result.sire_phenotype}} × {{result.dam_name || result.dam_phenotype}}
    </view>
  </view>
  <view class="card">
    <view style="font-weight:700;margin-bottom:12rpx;">宝宝可能长这样</view>
    <view class="outcome" wx:for="{{result.outcomes}}" wx:key="phenotype">
      <view class="out-name">{{item.displayName || item.phenotype}}</view>
      <view class="muted" style="font-size:22rpx;">{{item.aboutLabel}}</view>
      <view class="out-pct">{{item.percentLabel}}</view>
    </view>
  </view>
  <view class="card">
    <view style="font-weight:700;">专业信息（基因型）</view>
    <view class="muted" style="margin-top:8rpx;" wx:if="{{result.why}}">{{result.why.therefore}}</view>
    <view class="muted" style="margin-top:8rpx;" wx:for="{{result.outcomes}}" wx:key="phenotype">
      {{item.phenotype}} · {{item.percentLabel}}
    </view>
  </view>
</block>
