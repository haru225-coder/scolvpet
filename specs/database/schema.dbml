  Indexes {
    (owner_id, id) [unique, name: "uq_media_asset_owner_id_id"]
    (owner_id, original_object_key) [unique, name: "ux_media_asset_object_key_active"]
    (owner_id, kind, created_at) [name: "ix_media_asset_owner_kind_time"]
  }
}

