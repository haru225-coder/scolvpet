Table "pairing_attempt" {
  "id" uuid [pk, default: `gen_random_uuid()`]
  "owner_id" uuid [not null]
  "breeding_plan_id" uuid [not null]
  "attempt_no" integer [not null]
  "sire_id" uuid [not null]
