Table "account" {
  "id" uuid [pk, default: `gen_random_uuid()`]
  "phone_country_code" varchar(8) [not null, default: '+86']
  "phone_number" varchar(32) [not null]
  "status" account_status [not null, default: 'active']
  "display_name" varchar(120)
  "locale" varchar(16) [not null, default: 'zh-CN']
  "timezone" varchar(64) [not null, default: 'Asia/Shanghai']
  "version" integer [not null, default: 1]
  "created_at" timestamptz [not null, default: `now()`]
  "updated_at" timestamptz [not null, default: `now()`]
  "deleted_at" timestamptz

  Indexes {
    (phone_country_code, phone_number) [unique, name: "ux_account_phone_active"]
  }
}

Table "organization" {
  "id" uuid [pk, default: `gen_random_uuid()`]
  "owner_id" uuid [not null]
  "code" varchar(64) [not null]
  "name" varchar(160) [not null]
  "mode" organization_mode [not null, default: 'personal']
  "timezone" varchar(64) [not null, default: 'Asia/Shanghai']
  "weight_unit" varchar(8) [not null, default: 'g']
  "version" integer [not null, default: 1]
  "created_by" uuid
  "updated_by" uuid
  "created_at" timestamptz [not null, default: `now()`]
  "updated_at" timestamptz [not null, default: `now()`]
  "deleted_at" timestamptz

  Indexes {
    (owner_id, id) [unique, name: "uq_organization_owner_id_id"]
    (owner_id, code) [unique, name: "ux_organization_owner_code_active"]
  }
}

Table "species_rule_version" {
  "id" uuid [pk, default: `gen_random_uuid()`]
  "owner_id" uuid
  "scope" dictionary_scope [not null]
  "copied_from_id" uuid
  "species_code" varchar(64) [not null]
  "variety_scope" jsonb [not null, default: `'[]'::jsonb`]
  "display_name" varchar(160) [not null]
  "version_no" integer [not null]
  "status" species_rule_status [not null, default: 'draft']
  "gestation_min_days" integer [not null]
  "gestation_max_days" integer [not null]
  "pairing_max_minutes" integer
  "weaning_target_days" integer [not null]
  "sexing_target_days" integer [not null]
  "separation_target_days" integer [not null]
  "post_breeding_rest_days" integer
  "profile_creation_deadline_days" integer
  "weight_reference" jsonb [not null, default: `'{}'::jsonb`]
  "reminder_rules" jsonb [not null, default: `'{}'::jsonb`]
  "source_note" text [not null]
  "checksum" varchar(128) [not null]
  "effective_at" timestamptz [not null]
  "retired_at" timestamptz
  "version" integer [not null, default: 1]
  "created_by" uuid
  "updated_by" uuid
  "created_at" timestamptz [not null, default: `now()`]
  "updated_at" timestamptz [not null, default: `now()`]

  Indexes {
    (species_code, version_no) [unique, name: "ux_species_rule_system_version"]
    (owner_id, species_code, version_no) [unique, name: "ux_species_rule_owner_version"]
  }
}

Table "domain_event" {
  "id" uuid [pk, default: `gen_random_uuid()`]
  "owner_id" uuid [not null]
  "organization_id" uuid [not null]
  "aggregate_type" varchar(80) [not null]
  "aggregate_id" uuid [not null]
  "event_type" varchar(120) [not null]
  "event_version" integer [not null]
  "actor_id" uuid
  "occurred_at" timestamptz [not null]
  "recorded_at" timestamptz [not null, default: `now()`]
  "payload" jsonb [not null, default: `'{}'::jsonb`]
  "metadata" jsonb [not null, default: `'{}'::jsonb`]
  "idempotency_key" varchar(160)
  "correlation_id" uuid
  "causation_id" uuid
  "corrects_event_id" uuid
  "reverted_at" timestamptz

  Indexes {
    (owner_id, id) [unique, name: "uq_domain_event_owner_id_id"]
    (owner_id, aggregate_type, aggregate_id, event_version) [unique, name: "uq_domain_event_aggregate_version"]
    (owner_id, idempotency_key) [unique, name: "ux_domain_event_idempotency"]
    (owner_id, aggregate_id, event_type) [unique, name: "ux_domain_event_confirm_birth"]
    (owner_id, aggregate_type, aggregate_id, occurred_at) [name: "ix_domain_event_aggregate_time"]
  }
}

Table "outbox_message" {
  "id" uuid [pk, default: `gen_random_uuid()`]
  "owner_id" uuid [not null]
  "domain_event_id" uuid [not null]
  "topic" varchar(160) [not null]
  "partition_key" varchar(160) [not null]
  "payload" jsonb [not null]
  "status" outbox_status [not null, default: 'pending']
  "priority" smallint [not null, default: 100]
  "available_at" timestamptz [not null, default: `now()`]
  "attempt_count" integer [not null, default: 0]
  "max_attempts" integer [not null, default: 12]
  "locked_at" timestamptz
  "locked_by" varchar(160)
  "published_at" timestamptz
  "last_error" text
  "version" integer [not null, default: 1]
  "created_at" timestamptz [not null, default: `now()`]
  "updated_at" timestamptz [not null, default: `now()`]

  Indexes {
    (owner_id, id) [unique, name: "uq_outbox_message_owner_id_id"]
    (owner_id, domain_event_id) [unique, name: "uq_outbox_domain_event"]
    (status, available_at, priority, created_at) [name: "ix_outbox_claim"]
  }
}

Table "async_job" {
  "id" uuid [pk, default: `gen_random_uuid()`]
  "owner_id" uuid [not null]
  "organization_id" uuid
  "job_type" async_job_type [not null]
  "status" async_job_status [not null, default: 'queued']
  "priority" smallint [not null, default: 100]
  "progress_percent" numeric(5,2) [not null, default: 0]
  "request_payload" jsonb [not null, default: `'{}'::jsonb`]
  "result_payload" jsonb [not null, default: `'{}'::jsonb`]
  "idempotency_key" varchar(160) [not null]
  "attempt_count" integer [not null, default: 0]
  "max_attempts" integer [not null, default: 5]
  "available_at" timestamptz [not null, default: `now()`]
  "started_at" timestamptz
  "finished_at" timestamptz
  "locked_at" timestamptz
  "locked_by" varchar(160)
  "error_code" varchar(120)
  "error_detail" text
  "version" integer [not null, default: 1]
  "created_by" uuid
  "created_at" timestamptz [not null, default: `now()`]
  "updated_at" timestamptz [not null, default: `now()`]

  Indexes {
    (owner_id, id) [unique, name: "uq_async_job_owner_id_id"]
    (owner_id, idempotency_key) [unique, name: "uq_async_job_idempotency"]
    (status, available_at, priority, created_at) [name: "ix_async_job_claim"]
  }
}

Table "media_asset" {
  "id" uuid [pk, default: `gen_random_uuid()`]
  "owner_id" uuid [not null]
  "organization_id" uuid [not null]
  "kind" media_kind [not null]
  "status" media_upload_status [not null, default: 'pending_upload']
