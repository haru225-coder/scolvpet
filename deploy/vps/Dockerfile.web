FROM node:22-bookworm-slim AS build

WORKDIR /src
COPY apps/web/package.json ./apps/web/
RUN cd apps/web && npm install --omit=dev=false
COPY apps/web ./apps/web
RUN cd apps/web && npm run build

FROM node:22-bookworm-slim

WORKDIR /app
ENV NODE_ENV=production
ENV WEB_PORT=3000
COPY --from=build /src/apps/web/package.json /app/package.json
COPY --from=build /src/apps/web/dist /app/dist
COPY --from=build /src/apps/web/src /app/src
# Prefer built bundle when present; fall back to src for simple SSR.
EXPOSE 3000
CMD ["node", "dist/server.mjs"]
