APP_ENV=development
API_ADDR=:8080
DATABASE_URL=postgres://scolvpet:scolvpet@127.0.0.1:55432/scolvpet?sslmode=disable
JWT_SECRET=replace-with-a-local-development-secret
SMS_PROVIDER=mock
SMS_MOCK_CODE=123456
SMS_HTTP_ENDPOINT=
SMS_HTTP_TOKEN=
OBJECT_STORE_PROVIDER=local
IMPORT_OBJECT_STORE_DIR=/tmp/scolvpet-imports
OBJECT_STORE_ENDPOINT=
OBJECT_STORE_BUCKET=
OBJECT_STORE_REGION=us-east-1
OBJECT_STORE_ACCESS_KEY=
OBJECT_STORE_SECRET_KEY=
OBJECT_STORE_PATH_STYLE=
WEB_PORT=3000
WEB_API_BASE_URL=http://127.0.0.1:8080/v1
OUTBOX_WORKER_LEASE_SECONDS=60
OUTBOX_PUBLISHER_MODE=success
OUTBOX_PUBLISHER_ENDPOINT=
OUTBOX_PUBLISHER_TOKEN=
OUTBOX_WORKER_DISABLED=0
MEDIA_WORKER_INTERVAL_SECONDS=2
MEDIA_WORKER_DISABLED=0
OUTBOX_PUBLISHER_MODE=success
# Build command guards; these are consumed by make, not by the application.
FLUTTER_COMMAND_TIMEOUT_SECONDS=900
FLUTTER_BUILD_TIMEOUT_SECONDS=1800
GRADLE_NETWORK_TIMEOUT_MS=60000
OPENAPI_CLIENT_COMMAND_TIMEOUT_SECONDS=300
